# Server Command Center - backend configuration
#
# Copy to .env and configure authentication before accessing protected routes.
# Telemetry settings use generic defaults; customize the inventory below.
#
# SECURITY: keep credentials in a private environment file, never in git.
# The read-only fan observer never reads the Tuya Local Key.

# --- Bind address ---------------------------------------------------------
# Loopback only by default. Do not change to 0.0.0.0 without putting an
# authenticating reverse proxy in front of it.
SCC_HOST=127.0.0.1
SCC_PORT=18680

# --- Authentication -------------------------------------------------------
# Authentication is enabled by default. Configure these before exposing the
# dashboard through a reverse proxy. Generate a password hash with:
#   python -c "from app.auth import hash_password; import getpass; print(hash_password(getpass.getpass()))"
SCC_AUTH_ENABLED=true
SCC_AUTH_USERNAME=admin
SCC_AUTH_PASSWORD_HASH=
SCC_SESSION_SECRET=
SCC_AUTH_SESSION_TTL_S=43200

# --- Optional UUID-tracked external storage -------------------------------
# Leave UUID blank to disable incident tracking for a specific external disk.
# All mounted filesystems are still shown by the general Storage Overview.
SCC_EXTERNAL_STORAGE_UUID=
SCC_EXTERNAL_STORAGE_MOUNTPOINT=/mnt/data
SCC_EXTERNAL_STORAGE_NAME=External Storage

# --- Storage overview ordering --------------------------------------------
# Comma-separated mountpoints that sort first in the Storage Overview. The root
# filesystem ("/") is always pinned first; add deployment-specific important
# mounts here (any that are not present are simply ignored).
SCC_PINNED_MOUNTS=

# --- Sampling cadence -----------------------------------------------------
# Fast tick: cpu / memory / network / temperature / gpu / processes
SCC_FAST_INTERVAL_S=2.0
# Process tables need less frequent resolution than scalar metrics.
SCC_PROCESS_INTERVAL_S=4.0
SCC_GPU_PROCESS_INTERVAL_S=6.0
# Slow tick: services / storage / containers / fan
SCC_SLOW_INTERVAL_S=10.0

# --- Process tables -------------------------------------------------------
SCC_PROCESS_LIMIT=20
# Ordered JSON regex -> label map. First match wins before generic argv rules;
# named container identity still takes precedence. Invalid regexes are skipped.
# Restart the application after changing configuration.
# Example: SCC_PROCESS_LABELS_JSON={"example_api:app":"Example API","scripts.worker":"Example Worker"}
SCC_PROCESS_LABELS_JSON={}

# --- History --------------------------------------------------------------
# 10 s interval x 43200 points = ~120 h of rolling in-memory retention.
SCC_HISTORY_SAMPLE_INTERVAL_S=10.0
SCC_HISTORY_MAX_POINTS=43200

# --- Fan controller (READ-ONLY observation) -------------------------------
# The dashboard only reads this unit's journal. It never actuates the fan.
SCC_FAN_UNIT=cpu-fan-controller.service
SCC_FAN_JOURNAL_LINES=400
# Flag the fan data as stale when the controller has not polled for this long.
# The controller polls every 5 s, so 30 s means ~6 missed polls.
SCC_FAN_STALE_AFTER_S=30.0

# --- External binaries ----------------------------------------------------
SCC_NVIDIA_SMI=nvidia-smi
SCC_NVIDIA_SMI_TIMEOUT_S=4.0
SCC_DOCKER_BIN=docker
SCC_SYSTEMCTL_BIN=systemctl

# --- Service inventory -----------------------------------------------------
# Generic defaults monitor Docker + NetworkManager. Add system/user units as
# comma-separated lists; labels/ports are optional JSON maps.
SCC_SYSTEM_SERVICE_UNITS=docker.service,NetworkManager.service
SCC_USER_SERVICE_UNITS=
SCC_IMPORTANT_SYSTEM_UNITS=docker.service,NetworkManager.service
SCC_IMPORTANT_USER_UNITS=
SCC_OPTIONAL_USER_UNITS=
SCC_SERVICE_LABELS_JSON={}
SCC_SERVICE_PORTS_JSON={}

# --- Logging --------------------------------------------------------------
SCC_LOG_LEVEL=INFO

# --- Health thresholds ----------------------------------------------------
# CPU: the fan controller turns ON at 70 C, and coretemp reports a hardware
# critical of 100 C. Warning is aligned with the controller's own trigger.
SCC_CPU_TEMP_WARN_C=70.0
SCC_CPU_TEMP_CRIT_C=90.0

# GPU: GeForce 940MX is a passively cooled laptop part.
SCC_GPU_TEMP_WARN_C=75.0
SCC_GPU_TEMP_CRIT_C=82.0

SCC_RAM_WARN_PCT=85.0
SCC_RAM_CRIT_PCT=95.0
SCC_VRAM_WARN_PCT=90.0
SCC_VRAM_CRIT_PCT=97.0

SCC_DISK_WARN_PCT=85.0
SCC_DISK_CRIT_PCT=95.0

SCC_SWAP_WARN_PCT=50.0
SCC_SWAP_CRIT_PCT=80.0

SCC_CPU_LOAD_WARN_PER_CORE=1.5